  m_Script: {fileID: 11500000, guid: c5a827b0f96645d4588e7dec3615fc59, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialDirector
  nav: {fileID: 1181051309}
  video: {fileID: 231563281}
  voice: {fileID: 1835302327}
  subtitleText: {fileID: 2117242739}
  lines:
  - key: call_01
    clip: {fileID: 0}
    subtitle: 'Dean: Yo what is up dude!'
  - key: call_02
    clip: {fileID: 0}
    subtitle: 'You: Same old same old... just filling in for the secruity gaurd.'
  - key: call_homework
    clip: {fileID: 0}
    subtitle: 'Dean: Oh yeah! Gross... got a computer to play? Maybe some homework
      to do?'
  - key: homework_great
    clip: {fileID: 0}
    subtitle: 'You: Alright I did one.'
  - key: check_camera
    clip: {fileID: 0}
    subtitle: 'Dean: Sick... aren''t you trying to pay off that loan shark? Do you
      have anything to keep yourself safe? Like camers?'
  - key: gate_flash_him
    clip: {fileID: 0}
    subtitle: 'You: Oh crap he''s here!'
  - key: gate_exit_computer
    clip: {fileID: 0}
    subtitle: 'You: Hopefully he stays away.'
  - key: student_package
    clip: {fileID: 0}
    subtitle: 'Dean: Looks like you should keep an eye out for a package'
  - key: check_packages
    clip: {fileID: 0}
    subtitle: 'Dean: Will they be on the camera?'
  - key: package_flash
    clip: {fileID: 0}
    subtitle: 'You: Yeah... OH he''s trying to grab it!'
  - key: package_great
    clip: {fileID: 0}
    subtitle: 'You: Hold on I''m going to let him in.'
